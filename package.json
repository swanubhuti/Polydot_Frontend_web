{
  "name": "easydairy-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix build",
    "dev": "cross-env AWS_PROFILE=local_web_dev_role remix dev --manual -c \"node ./server.js\"",
    "start": "cross-env NODE_ENV=production node ./server.js",
    "start:e2e": "dotenv -e .env cross-env NODE_ENV=production node ./server.js",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "dbCleanup:deleteUsers": "node ./dbCleanup/deleteUsers.js",
    "test:runAll": "npm run cypress:run && npm run dbCleanup:deleteUsers",
    "test": "start-server-and-test start:e2e http://localhost:3000 cypress:run",
    "typecheck": "tsc",
    "format:head": "prettier --write $(git diff-tree --no-commit-id --name-only HEAD -r | grep -E '\\.(j|t)sx?$|\\.css$|\\.html$' | xargs)",
    "format:changed": "prettier --write $(git diff --name-only --diff-filter d | grep -E '\\.(j|t)sx?$|\\.css$|\\.html$' |  xargs)"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.502.0",
    "@headlessui/react": "^1.7.17",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-toast": "^1.1.5",
    "@remix-run/css-bundle": "^2.0.1",
    "@remix-run/express": "^2.0.1",
    "@remix-run/node": "^2.0.1",
    "@remix-run/react": "^2.0.1",
    "clsx": "^2.0.0",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.1",
    "express": "^4.18.2",
    "is-ip": "^5.0.1",
    "isbot": "^3.6.8",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "morgan": "^1.10.0",
    "papaparse": "^5.5.2",
    "pg": "^8.11.5",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-cropper": "^2.3.3",
    "react-datepicker": "^7.4.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-quill": "^2.0.0",
    "recharts": "^2.8.0",
    "source-map-support": "^0.5.21",
    "tailwind-merge": "^1.14.0",
    "tiny-invariant": "^1.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.0.1",
    "@remix-run/eslint-config": "^2.0.1",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.4",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/source-map-support": "^0.5.6",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.16",
    "chokidar": "^3.5.3",
    "cypress": "^13.14.0",
    "eslint": "^8.45.0",
    "postcss": "^8.4.30",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
